# Vite loads frontend/.env.local (copy ONLY if that file does not already exist).
# Public build-time settings: never put credentials in VITE_ variables.
# Development-only examples; keep existing .env.local unchanged.
# In Vercel, set VITE_API_BASE_URL to the deployed HTTPS API ORIGIN in
# Production/Preview environment settings, with no /api path or credentials.
# Production builds reject missing, HTTP and loopback API origins.
VITE_API_BASE_URL=http://127.0.0.1:8765
VITE_DEMO_PROFILE_ID=demo-student
# This ID is not provisioned on a fresh checkout. Create/review/confirm a resume
# through Student Profile, or select an existing ID in your own local environment.
