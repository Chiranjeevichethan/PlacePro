# ---- PlacePro Student Dashboard ----
# Copy to .env and adjust.

# Backend (FastAPI) base URL - never hard-code localhost in components.
VITE_API_URL=http://127.0.0.1:8000

# Development/demo profile used when no real profile is selected yet.
# Create one with: python backend/scripts/seed_demo_profile.py
# Isolated in src/config/demo.ts - this is a DEMO-only fallback.
VITE_DEMO_PROFILE_ID=demo-student
