# Exclude everything unless explicitly needed by this backend image.
**
!Dockerfile
!.dockerignore
!requirements.txt
!backend/
backend/**
!backend/__init__.py
!backend/container_start.py
!backend/app/
backend/app/**
!backend/app/*.py
!backend/app/routes/
backend/app/routes/**
!backend/app/routes/*.py
!backend/app/services/
backend/app/services/**
!backend/app/services/*.py
!backend/app/data/
backend/app/data/**
!backend/app/data/*.py
!src/
src/**
!src/pipeline.py
!models/
models/**
!models/placepro_final_model.pkl
!models/placepro_salary_model_v2.pkl
!experimental/
experimental/**
!experimental/v1/
experimental/v1/**
!experimental/v1/feature_schema.py
!experimental/v1/placepro_v1_production_fields.pkl

# These exclusions apply even inside an otherwise permitted code directory.
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.bak*
**/*~
**/.env*
**/*.db*
**/*.sqlite*
**/*.pem
**/*.key
**/*.log
